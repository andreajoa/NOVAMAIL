# Rendered by bootstrap.sh with envsubst. Do not commit the rendered file.
version: 2

postal:
  web_hostname: ${POSTAL_HOST}
  web_protocol: https
  smtp_hostname: ${POSTAL_HOST}
  use_ip_pools: true
  signing_key_path: /config/signing.key
  trusted_proxies: ["127.0.0.1", "::1"]
  default_maximum_delivery_attempts: 18
  default_suppression_list_automatic_removal_days: 90

web_server:
  default_port: 5000
  default_bind_address: 127.0.0.1

worker:
  threads: 4

main_db:
  host: 127.0.0.1
  username: root
  password: ${MARIADB_ROOT_PASSWORD}
  database: postal
  pool_size: 20

message_db:
  host: 127.0.0.1
  username: root
  password: ${MARIADB_ROOT_PASSWORD}
  database_name_prefix: postal

logging:
  rails_log_enabled: false
  level: INFO

smtp_server:
  default_port: 25
  tls_enabled: true
  # Caddy obtains/renews the certificate; sync-tls.sh copies it here (uid 999, mode 600).
  tls_certificate_path: /config/tls/smtp.crt
  tls_private_key_path: /config/tls/smtp.key
  max_message_size: 25

dns:
  mx_records: ["mx.${MAIL_DOMAIN}"]
  spf_include: spf.${MAIL_DOMAIN}
  return_path_domain: rp.${MAIL_DOMAIN}
  route_domain: routes.${MAIL_DOMAIN}
  track_domain: track.${MAIL_DOMAIN}
  helo_hostname: ${POSTAL_HOST}
  dkim_identifier: nm
  dkim_key_size: 2048
  domain_verify_prefix: novamail-verification
  custom_return_path_prefix: nmrp

smtp:
  host: 127.0.0.1
  port: 25
  from_name: NovaMail
  from_address: no-reply@${MAIL_DOMAIN}

rails:
  environment: production
  secret_key: ${RAILS_SECRET_KEY}
